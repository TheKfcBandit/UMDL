#!/usr/bin/env python3
"""Stand-in for pip. "Installs" the stand-in download tools by copying them
into $HOME/site-packages, which the simulator puts on PYTHONPATH.

A file named $HOME/.fake-pip-fail makes every install fail with its contents
as the error message. A file named $HOME/.fake-pip-target holds a folder name
to install into instead, one Python is not searching; "pip show" reports it.
Each install is logged to $HOME/pip.log.
"""
import os
import shutil
import sys

home = os.environ.get("HOME", "")
here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
target = os.path.join(home, "site-packages")
redirect = os.path.join(home, ".fake-pip-target")
if os.path.exists(redirect):
    with open(redirect) as handle:
        target = os.path.join(home, handle.read().strip())
modules = {"yt-dlp": "yt_dlp", "gallery-dl": "gallery_dl"}
words = [a for a in sys.argv[1:] if not a.startswith("-")]
if words[:1] == ["show"]:
    shown = [p for p in words[1:] if os.path.isdir(os.path.join(target, modules.get(p, "?")))]
    for package in shown:
        sys.stdout.write("Name: %s\nLocation: %s\n---\n" % (package, target))
    sys.exit(0 if shown else 1)
packages = [a for a in words if a != "install"]
with open(os.path.join(home, "pip.log"), "a") as handle:
    handle.write(" ".join(packages) + "\n")
flag = os.path.join(home, ".fake-pip-fail")
if os.path.exists(flag):
    with open(flag) as handle:
        sys.stderr.write("ERROR: " + (handle.read().strip() or "pip failed") + "\n")
    sys.exit(1)
for package in packages:
    module = modules.get(package)
    if module:
        os.makedirs(target, exist_ok=True)
        shutil.copytree(os.path.join(here, "site", module), os.path.join(target, module),
                        dirs_exist_ok=True)
