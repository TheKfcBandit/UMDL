#!/usr/bin/env python3
"""Stand-in for the gallery-dl command line, driven by UMDL_FAKE_SCENARIO."""
import json
import os
import shutil
import sys

args = sys.argv[1:]
scenario = {}
if os.environ.get("UMDL_FAKE_SCENARIO"):
    with open(os.environ["UMDL_FAKE_SCENARIO"]) as handle:
        scenario = json.load(handle).get("gallery") or {}
count = int(os.environ.get("FAKE_GALLERY_COUNT") or scenario.get("count", 3))
sample = os.environ.get("FAKE_GALLERY_SAMPLE") or scenario.get("sample", "")
fail = os.environ.get("FAKE_GALLERY_FAIL") or scenario.get("fail", "")
if fail:
    sys.stderr.write("[fakegallery][error] " + fail + "\n")
    sys.exit(4)
# Direct links to files need no site at all: one file per link, never blocked.
links = []
if "--input-file" in args:
    with open(args[args.index("--input-file") + 1]) as handle:
        links = handle.read().split()
direct = bool(links) and all(
    link.rsplit(".", 1)[-1].lower() in ("jpg", "jpeg", "png", "gif", "webp", "mp4") for link in links)
if direct:
    count = len(links)
    record = os.path.join(os.environ.get("HOME", ""), "direct-links.log")
    with open(record, "a") as handle:
        handle.write(" ".join(links) + "\n")
# A site that turns away everything except its API ("api=oauth").
blocked = scenario.get("blocked_unless_api", "") if not direct else ""
if blocked and "api=oauth" not in args:
    sys.stderr.write("[fakegallery][error] " + blocked + "\n")
    sys.exit(4)
# gallery-dl 1.32 crashes in its API mode unless a refresh token is given.
if "api=oauth" in args and "refresh-token=" not in args:
    sys.stderr.write("[fakegallery][error] An unexpected error occurred: AttributeError\n")
    sys.exit(1)
if scenario.get("api_fail") and "api=oauth" in args:
    sys.stderr.write("[fakegallery][error] AuthenticationError: " + scenario["api_fail"] + "\n")
    sys.exit(4)
limit = count
if "--range" in args:
    limit = min(count, int(args[args.index("--range") + 1].split("-")[-1]))
if "--get-urls" in args:
    for i in range(limit):
        print("https://example.test/img%d.jpg" % i)
        print("| https://mirror.test/img%d.jpg" % i)
    sys.exit(0)
folder = args[args.index("--directory") + 1]
for i in range(limit):
    target = os.path.join(folder, "pic %d.jpg" % i)
    shutil.copy(sample, target)
    print(target)
