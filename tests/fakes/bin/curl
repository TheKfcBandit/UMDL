#!/usr/bin/env python3
"""Stand-in for curl, so the tests never touch the network.

Serves the repository's own helper script and a version file the test
controls ($HOME/.fake-version.json). $HOME/.fake-offline makes every request
fail the way `curl -f` does; $HOME/.fake-no-background-curl does the same for
commands run outside the a-Shell window only.
"""
import os
import shutil
import sys

args = sys.argv[1:]
home = os.environ.get("HOME", "")
root = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))))
url = next((a for a in args if a.startswith("http")), "")
output = args[args.index("-o") + 1] if "-o" in args else None
flags = "".join(a[1:] for a in args if a.startswith("-") and not a.startswith("--"))
if "f" not in flags:
    sys.stderr.write("fake curl: called without -f; an error page would be saved as if it were the file\n")
    sys.exit(2)
if os.path.exists(os.path.join(home, ".fake-offline")):
    sys.exit(22)
if (os.path.exists(os.path.join(home, ".fake-no-background-curl"))
        and os.environ.get("UMDL_SIM_WINDOW") != "open"):
    sys.exit(7)
if url.endswith("/src/umdl.py"):
    source = os.path.join(root, "src", "umdl.py")
elif url.endswith("/version.json"):
    source = os.path.join(home, ".fake-version.json")
else:
    sys.exit(22)
if not os.path.exists(source):
    sys.exit(22)
if output:
    shutil.copy(source, output)
else:
    with open(source) as handle:
        sys.stdout.write(handle.read())
