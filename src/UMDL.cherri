/*
 * UMDL - Universal Media Downloader
 * One tap from the share sheet: the best available quality, saved straight to Photos.
 *
 * This shortcut is the front end: it collects the link, shows the menus and
 * reports the result. Downloading, converting and saving to Photos are done by
 * src/umdl.py, which runs yt-dlp and gallery-dl inside the free a-Shell app.
 *
 * Build from the repository root:   cherri src/UMDL.cherri
 * Project: https://github.com/TheKfcBandit/UMDL   Licence: MIT
 *
 * Every screen and every path through this file is described in
 * docs/BEHAVIOR.md. Keep the two in step.
 *
 * Rules this file follows. The first three were learned on a real device.
 *
 *   1. Never test a text for "has any value". Shortcuts treats an empty text
 *      as a value. Emptiness is tested by wrapping the text in brackets and
 *      comparing with "[]".
 *   2. No file is passed from a-Shell to this shortcut. a-Shell's "Get File"
 *      stops the shortcut on large files, and on iOS 27.2 on any file unless
 *      asked for a copy. The helper saves to Photos itself.
 *   3. Background a-Shell commands set "keepGoing". Without it a command
 *      that exits with an error stops the shortcut with no message.
 *   4. Cherri functions are not used. They re-run the shortcut and read its
 *      input, which is the same channel the helper's callback uses.
 *   5. Wording: say it once, in few words. Symbols mark actions, not values.
 */

#define name UMDL
#define color blue
#define glyph downloadArrow
#define inputs url, text
#define from sharesheet

#include 'actions/crypto'
#include 'actions/text'
#include 'actions/web'
#include 'actions/device'
#include 'actions/sharing'

// Keep in step with version.json. The protocol number only changes when the
// payload or callback format does.
@umdlVersion = "1.7.0"
@protocol = "7"

@shared = "{ShortcutInput}"
@link = ""
@hasLink = "0"
@runMode = "auto"
@runLimit = ""
@runConvert = ""
@forceUpdate = ""
@toolCmd = "none"
@signInTo = ""
@resumeBlob = ""
@choice = ""
@firstRun = "0"
@openSettings = "0"
@probe = ""

// Settings, with their defaults.
@cfgAlbum = "UMDL"
@cfgThreshold = "10"
@cfgAfter = "notify"
@cfgRes = "best"
@cfgFps = "best"
@cfgDest = "photos"
@cfgConvert = "ask"
@haveCfg = "0"
@needsHelper = "0"
@saveCfg = "0"

@jobTitle = ""
@updateVersion = ""
@updateLink = ""
@doneText = ""
@openLink = ""

/* ------------------------------------------------------------------------
 * 1. What started this run: a callback from the helper, or something shared
 * ---------------------------------------------------------------------- */

// Sent by the in-app helper download (section 7) when it fails.
if @shared == "UMDL-HELPER-MISSING" {
    alert("The helper could not be downloaded. Check the connection, then run UMDL again.", "Setup incomplete")
    stop()
}

if @shared beginsWith "UMDLCB:" {
    const cbBlob = replaceText("UMDLCB:", "", @shared)
    const cbData = base64Decode(cbBlob)
    @cbJSON = "{cbData}"
    // A callback that cannot be read is ignored: the run continues as if nothing was shared.
    if @cbJSON contains "\"t\":" {
        const cb = getDictionary(@cbJSON)
        @cbType = "{cb['t']}"

        // Every callback carries the settings back, so no second trip to a-Shell.
        const cbCfgRaw = getValue(cb, "cfg")
        const cbCfg = getDictionary(cbCfgRaw)
        @probe = "[{cbCfg['album']}]"
        if @probe != "[]" {
            @cfgAlbum = "{cbCfg['album']}"
            @cfgThreshold = "{cbCfg['threshold']}"
            @cfgAfter = "{cbCfg['after']}"
            @cfgRes = "{cbCfg['res']}"
            @cfgFps = "{cbCfg['fps']}"
            @cfgDest = "{cbCfg['dest']}"
            @cfgConvert = "{cbCfg['convert']}"
            @haveCfg = "1"
        }

        // The helper has put the files where they belong. "msg" says where.
        if @cbType == "done" {
            @doneText = "{cb['msg']}"
            @openLink = "{cb['open']}"
            @jobTitle = "{cb['title']}"
            @updateVersion = "{cb['upv']}"
            @updateLink = "{cb['upurl']}"
        }

        if @cbType == "confirm" {
            @link = "{cb['url']}"
            @confirmLimit = "{cb['thr']}"
            @confirmPrompt = "More than {@confirmLimit} items."
            @probe = "[{cb['n']}]"
            if @probe != "[]" {
                @confirmPrompt = "{cb['n']} items."
            }
            @probe = "[{cb['title']}]"
            if @probe != "[]" {
                @confirmPrompt = "{cb['title']}\n\n{@confirmPrompt}"
            }
            menu "{@confirmPrompt}" {
                item "⬇️ Download all":
                    @runMode = "all"
                item "⬇️ First {@confirmLimit}":
                    @runMode = "limit"
                    @runLimit = @confirmLimit
                item "⬇️ First only":
                    @runMode = "first"
                item "Cancel":
                    stop()
            }
        }

        // The best version has to be converted for Photos, and a smaller one does not.
        if @cbType == "choose" {
            @link = "{cb['url']}"
            @choosePrompt = "Higher quality available"
            @probe = "[{cb['title']}]"
            if @probe != "[]" {
                @choosePrompt = "{@choosePrompt}\n\n{cb['title']}"
            }
            menu "{@choosePrompt}\n\n{cb['best']} has to be converted for Photos, which can take a while. {cb['native']} is saved as it is.\n\nSettings, Conversion makes either the rule." {
                item "🎞️ {cb['best']}, converted":
                    @runConvert = "yes"
                item "⚡ {cb['native']}, as it is":
                    @runConvert = "no"
                item "Cancel":
                    stop()
            }
        }

        if @cbType == "error" {
            @errKind = "{cb['kind']}"
            @errText = "{cb['msg']}"
            @errLink = "{cb['url']}"
            if @errKind == "install" {
                alert("The download tools could not be installed.\n\n{@errText}", "Setup incomplete")
                stop()
            }
            if @errKind == "outdated" {
                menu "UMDL is out of date.\n\n{@errText}" {
                    item "⬇️ Get the latest version":
                        openURL("https://github.com/TheKfcBandit/UMDL/releases/latest")
                        stop()
                    item "Cancel":
                        stop()
                }
            }
            if @errKind == "nolink" {
                alert("Share a post or video to UMDL, or copy its link first.", "No link")
                stop()
            }
            @errHint = "Updating the tools fixes most failures."
            if @errKind == "auth" {
                @errHint = "Sign in to the site, then try again."
            }
            if @errKind == "network" {
                @errHint = "Check the connection."
            }
            if @errKind == "gone" {
                @errHint = "The post may be private, removed or region-locked."
            }
            if @errKind == "drm" {
                @errHint = "Copy-protected media cannot be downloaded."
            }
            if @errKind == "unsupported" {
                @errHint = "This site may not be supported."
            }
            menu "Download failed\n\n{@errText}\n\n{@errHint}" {
                item "🔄 Try again":
                    @link = @errLink
                item "🛠️ Update tools and retry":
                    @link = @errLink
                    @forceUpdate = "1"
                item "🔑 Sign in":
                    @signInTo = @errLink
                item "📋 Copy details":
                    const errLog = rawAction("AsheKube.app.a-Shell.ExecuteCommandIntent", {
                        "command": "tail -n 40 $HOME/Documents/UMDL/last.log",
                        "openWindow": "close",
                        "keepGoing": true,
                        "ShowWhenRun": false
                    })
                    @errReport = "UMDL {@umdlVersion}\n{@errLink}\n{@errKind}: {@errText}\n\nLog\n{errLog}"
                    setClipboard(@errReport)
                    showNotification("Details copied.", "UMDL")
                    stop()
                item "Cancel":
                    stop()
            }
        }

        if @cbType == "info" {
            alert("{cb['msg']}", "{cb['title']}")
            stop()
        }

        if @cbType == "status" {
            @statusText = "{cb['msg']}"
            alert("{@statusText}", "Status")
            menu "Copy the status and log?" {
                item "📋 Copy":
                    const statusLog = rawAction("AsheKube.app.a-Shell.ExecuteCommandIntent", {
                        "command": "tail -n 40 $HOME/Documents/UMDL/last.log",
                        "openWindow": "close",
                        "keepGoing": true,
                        "ShowWhenRun": false
                    })
                    @statusReport = "{@statusText}\n\nLog\n{statusLog}"
                    setClipboard(@statusReport)
                    showNotification("Status and log copied.", "UMDL")
                    stop()
                item "Done":
                    stop()
            }
        }

        if @cbType == "setup" {
            alert("Share a post or video to UMDL to download it.\n\nOpen UMDL in Shortcuts for settings.", "UMDL is ready")
            stop()
        }
    }
} else {
    const sharedLinks = getURLs(@shared)
    const sharedFirst = getFirstItem(sharedLinks)
    @link = "{sharedFirst}"
}

@probe = "[{@link}]"
if @probe != "[]" {
    @hasLink = "1"
}

/* ------------------------------------------------------------------------
 * 2. Settings and state, read from a-Shell without opening it
 * ---------------------------------------------------------------------- */

if @haveCfg == "0" {
    const preflight = rawAction("AsheKube.app.a-Shell.ExecuteCommandIntent", {
        "command": "dash -c 'W=\"$HOME/Documents/UMDL\"; if [ -f $W/config.b64 ]; then echo \"CFG:$(cat $W/config.b64)\"; fi; if [ -f $W/umdl.py ] && [ -f $W/helper.for ]; then echo \"FOR:$(cat $W/helper.for):END\"; fi; if [ -f $W/last.b64 ]; then echo \"LAST:$(cat $W/last.b64)\"; fi; echo DONE'",
        "openWindow": "close",
        "keepGoing": true,
        "ShowWhenRun": false
    })
    @state = "{preflight}"

    // The helper is fetched again whenever the shortcut's version changes.
    @needsHelper = "1"
    if @state contains "FOR:{@umdlVersion}:END" {
        @needsHelper = "0"
    }

    const cfgMatch = matchText("CFG:(\\S+)", @state)
    const cfgGroup = getMatchGroup(cfgMatch, 1)
    @cfgBlob = "{cfgGroup}"
    @probe = "[{@cfgBlob}]"
    if @probe != "[]" {
        const cfgData = base64Decode(@cfgBlob)
        @cfgJSON = "{cfgData}"
        // A damaged settings file is treated as no settings, not as an error.
        if @cfgJSON contains "\"album\"" {
            const cfg = getDictionary(@cfgJSON)
            @cfgAlbum = "{cfg['album']}"
            @cfgThreshold = "{cfg['threshold']}"
            @cfgAfter = "{cfg['after']}"
            @cfgRes = "{cfg['res']}"
            @cfgFps = "{cfg['fps']}"
            @cfgDest = "{cfg['dest']}"
            @cfgConvert = "{cfg['convert']}"
            @haveCfg = "1"
        }
    }

    const lastMatch = matchText("LAST:(\\S+)", @state)
    const lastGroup = getMatchGroup(lastMatch, 1)
    @resumeBlob = "{lastGroup}"
}

// A setting that is missing falls back to its default.
@probe = "[{@cfgAlbum}]"
if @probe == "[]" {
    @cfgAlbum = "Recents"
}
@probe = "[{@cfgThreshold}]"
if @probe == "[]" {
    @cfgThreshold = "10"
}
@probe = "[{@cfgAfter}]"
if @probe == "[]" {
    @cfgAfter = "notify"
}
@probe = "[{@cfgRes}]"
if @probe == "[]" {
    @cfgRes = "best"
}
@probe = "[{@cfgFps}]"
if @probe == "[]" {
    @cfgFps = "best"
}
// These two have a fixed set of values. Anything else, such as the "convert"
// that versions before 1.5 stored, counts as not set.
if @cfgDest != "files" {
    @cfgDest = "photos"
}
if @cfgConvert != "yes" {
    if @cfgConvert != "no" {
        @cfgConvert = "ask"
    }
}
/* ------------------------------------------------------------------------
 * 3. First run
 * ---------------------------------------------------------------------- */

if @haveCfg == "0" {
    menu "Welcome to UMDL\n\nSaves shared posts and videos to Photos at the best quality.\n\nSetup takes about two minutes." {
        item "✅ Quick setup":
            @saveCfg = "1"
            @firstRun = "1"
        item "⚙️ Custom setup":
            @openSettings = "1"
            @saveCfg = "1"
            @firstRun = "1"
        item "Not now":
            stop()
    }
}

/* ------------------------------------------------------------------------
 * 4. A download has finished: say so
 * ---------------------------------------------------------------------- */

@probe = "[{@doneText}]"
if @probe != "[]" {
    @summaryTitle = "UMDL"
    @probe = "[{@jobTitle}]"
    if @probe != "[]" {
        @summaryTitle = @jobTitle
    }
    showNotification("{@doneText}", "{@summaryTitle}")

    @probe = "[{@updateVersion}]"
    if @probe != "[]" {
        menu "UMDL {@updateVersion} is available. Installed: {@umdlVersion}." {
            item "⬇️ Get the update":
                openURL("{@updateLink}")
                stop()
            item "Later":
                @probe = "[]"
        }
    }
    if @hasLink == "0" {
        // The helper says where the download went: Photos, or its folder in Files.
        @probe = "[{@openLink}]"
        if @probe != "[]" {
            if @cfgAfter == "photos" {
                openURL("{@openLink}")
            }
        }
        stop()
    }
}

/* ------------------------------------------------------------------------
 * 5. Opened without a link: the main menu
 * ---------------------------------------------------------------------- */

@needsMenu = "1"
if @hasLink == "1" {
    @needsMenu = "0"
}
if @firstRun == "1" {
    @needsMenu = "0"
}
@probe = "[{@signInTo}]"
if @probe != "[]" {
    @needsMenu = "0"
}

if @needsMenu == "1" {
    const iconDownload = embedFile("assets/icons/download.png")
    const iconResume = embedFile("assets/icons/resume.png")
    const iconSettings = embedFile("assets/icons/settings.png")
    const iconKey = embedFile("assets/icons/key.png")
    const iconUpdate = embedFile("assets/icons/update.png")
    const iconInfo = embedFile("assets/icons/info.png")
    const iconStatus = embedFile("assets/icons/status.png")

    @cards = "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Download from clipboard;;;;\nORG;CHARSET=utf-8:The link you copied;\nPHOTO;ENCODING=b:{iconDownload}\nEND:VCARD\n"
    @probe = "[{@resumeBlob}]"
    if @probe != "[]" {
        @cards = "{@cards}BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Resume last download;;;;\nORG;CHARSET=utf-8:Continue where it stopped;\nPHOTO;ENCODING=b:{iconResume}\nEND:VCARD\n"
    }
    @cards = "{@cards}BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Settings;;;;\nORG;CHARSET=utf-8:Album, quality, mode;\nPHOTO;ENCODING=b:{iconSettings}\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Sign in to a site;;;;\nORG;CHARSET=utf-8:For private posts;\nPHOTO;ENCODING=b:{iconKey}\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Status;;;;\nORG;CHARSET=utf-8:Sign-ins, versions, log;\nPHOTO;ENCODING=b:{iconStatus}\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Update tools;;;;\nORG;CHARSET=utf-8:Latest yt-dlp and gallery-dl;\nPHOTO;ENCODING=b:{iconUpdate}\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:About UMDL;;;;\nORG;CHARSET=utf-8:Version {@umdlVersion};\nPHOTO;ENCODING=b:{iconInfo}\nEND:VCARD\n"

    // The third argument keeps the name exactly as written, so the text becomes a .vcf file.
    const cardsFile = setName(@cards, "umdl-menu.vcf", true)
    @cardsContacts = cardsFile.contact
    const cardsPick = chooseFromList(@cardsContacts, "UMDL")
    @choice = "{cardsPick}"

    if @choice == "Download from clipboard" {
        @clipText = "{Clipboard}"
        const clipLinks = getURLs(@clipText)
        const clipFirst = getFirstItem(clipLinks)
        @link = "{clipFirst}"
        @probe = "[{@link}]"
        if @probe == "[]" {
            alert("The clipboard holds no link.", "No link")
            stop()
        }
        @hasLink = "1"
    }

    if @choice == "Resume last download" {
        @toolCmd = "resume"
    }

    if @choice == "Update tools" {
        @toolCmd = "update"
    }

    if @choice == "Status" {
        @toolCmd = "status"
    }

    if @choice == "Settings" {
        @openSettings = "1"
    }

    if @choice == "Sign in to a site" {
        menu "Sign in to" {
            item "Instagram":
                @signInTo = "https://www.instagram.com/accounts/login/"
            item "X (Twitter)":
                @signInTo = "https://x.com/login"
            item "Reddit":
                @signInTo = "https://www.reddit.com/login/"
            item "TikTok":
                @signInTo = "https://www.tiktok.com/login"
            item "Facebook":
                @signInTo = "https://m.facebook.com/login/"
            item "Another site":
                const siteTyped = prompt("Sign-in page address", "URL", "https://")
                @siteText = "{siteTyped}"
                const siteLinks = getURLs(@siteText)
                const siteFirst = getFirstItem(siteLinks)
                @siteLink = "{siteFirst}"
                @probe = "[{@siteLink}]"
                if @probe == "[]" {
                    alert("That is not a web address.", "Sign in")
                    stop()
                }
                @signInTo = @siteLink
        }
    }

    if @choice == "About UMDL" {
        menu "UMDL {@umdlVersion}\n\nFree and open source.\nBuilt on yt-dlp, gallery-dl and a-Shell." {
            item "🔄 Check for updates":
                const latestRaw = rawAction("AsheKube.app.a-Shell.ExecuteCommandIntent", {
                    "command": "curl -fsL --max-time 10 https://raw.githubusercontent.com/TheKfcBandit/UMDL/main/version.json",
                    "openWindow": "close",
                    "keepGoing": true,
                    "ShowWhenRun": false
                })
                @latestText = "{latestRaw}"
                if @latestText !contains "\"shortcut\"" {
                    alert("GitHub could not be reached.", "Update check")
                    stop()
                }
                const latest = getDictionary(@latestText)
                @latestVersion = "{latest['shortcut']}"
                if @latestVersion == @umdlVersion {
                    alert("{@umdlVersion} is the latest version.", "Up to date")
                    stop()
                }
                menu "UMDL {@latestVersion} is available. Installed: {@umdlVersion}.\n\n{latest['notes']}" {
                    item "⬇️ Get the update":
                        openURL("{latest['url']}")
                    item "Later":
                        @latestVersion = ""
                }
                stop()
            item "🌐 Project page":
                openURL("https://github.com/TheKfcBandit/UMDL")
                stop()
            item "Done":
                stop()
        }
    }
}

/* ------------------------------------------------------------------------
 * 6. Settings: one list that stays open. Custom setup uses it too.
 *
 * Each row shows its value. A row with two values switches when tapped; a
 * row with more opens one menu. Every change is saved at once.
 *
 * Resolution and frame rate limit which version is downloaded. "Save to" says
 * where it ends: Photos, or Files, where nothing is ever converted.
 * "Conversion" settles one question in advance: when the best version has
 * to be converted for Photos and a smaller one does not, which to take.
 * ---------------------------------------------------------------------- */

if @openSettings == "1" {
    const iconAlbum = embedFile("assets/icons/album.png")
    const iconResolution = embedFile("assets/icons/resolution.png")
    const iconFps = embedFile("assets/icons/fps.png")
    const iconStack = embedFile("assets/icons/stack.png")
    const iconConvert = embedFile("assets/icons/convert.png")
    const iconFinish = embedFile("assets/icons/finish.png")
    const iconReset = embedFile("assets/icons/reset.png")
    const iconDone = embedFile("assets/icons/done.png")

    @settingsOpen = "1"
    @settingsChanged = "0"
    repeat settingsRound for 40 {
        if @settingsOpen == "1" {
            // Commas, semicolons and backslashes are separators inside a vCard.
            const albumShown = replaceText("[\\\\;,]", " ", @cfgAlbum, true, true)
            @albumDetail = "{albumShown}"
            if @cfgAlbum == "Recents" {
                @albumDetail = "Library only"
            }
            if @cfgDest == "files" {
                @albumDetail = "Files"
            }
            @convertDetail = "Ask each time"
            if @cfgConvert == "yes" {
                @convertDetail = "Always, for the best quality"
            }
            if @cfgConvert == "no" {
                @convertDetail = "Never, take what Photos plays"
            }
            if @cfgDest == "files" {
                @convertDetail = "Not needed for Files"
            }
            @resDetail = "Up to {@cfgRes}p"
            if @cfgRes == "best" {
                @resDetail = "Best available"
            }
            @fpsDetail = "Up to {@cfgFps} fps"
            if @cfgFps == "best" {
                @fpsDetail = "Best available"
            }
            @afterDetail = "Show a notification"
            if @cfgAfter == "photos" {
                @afterDetail = "Open Photos or Files"
            }
            @doneDetail = "Close settings"
            if @firstRun == "1" {
                @doneDetail = "Install and finish"
            }

            @settingCards = "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Save to;;;;\nORG;CHARSET=utf-8:{@albumDetail};\nPHOTO;ENCODING=b:{iconAlbum}\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Resolution;;;;\nORG;CHARSET=utf-8:{@resDetail};\nPHOTO;ENCODING=b:{iconResolution}\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Frame rate;;;;\nORG;CHARSET=utf-8:{@fpsDetail};\nPHOTO;ENCODING=b:{iconFps}\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Conversion;;;;\nORG;CHARSET=utf-8:{@convertDetail};\nPHOTO;ENCODING=b:{iconConvert}\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Large downloads;;;;\nORG;CHARSET=utf-8:Ask above {@cfgThreshold} items;\nPHOTO;ENCODING=b:{iconStack}\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:When finished;;;;\nORG;CHARSET=utf-8:{@afterDetail};\nPHOTO;ENCODING=b:{iconFinish}\nEND:VCARD\n"
            // Nothing to reset before setup has finished.
            if @firstRun == "0" {
                @settingCards = "{@settingCards}BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Reset;;;;\nORG;CHARSET=utf-8:Sign out, or remove everything;\nPHOTO;ENCODING=b:{iconReset}\nEND:VCARD\n"
            }
            @settingCards = "{@settingCards}BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Done;;;;\nORG;CHARSET=utf-8:{@doneDetail};\nPHOTO;ENCODING=b:{iconDone}\nEND:VCARD\n"

            const settingsFile = setName(@settingCards, "umdl-settings.vcf", true)
            @settingsContacts = settingsFile.contact
            const settingsPick = chooseFromList(@settingsContacts, "Settings")
            @setting = "{settingsPick}"
            @settingTouched = "0"

            if @setting == "Save to" {
                // The helper finds the album by this name, or makes it.
                menu "Save to" {
                    item "🖼️ An album":
                        @albumOffer = @cfgAlbum
                        if @cfgAlbum == "Recents" {
                            @albumOffer = "UMDL"
                        }
                        const albumTyped = prompt("Album name", nil, "{@albumOffer}")
                        @albumName = "{albumTyped}"
                        @probe = "[{@albumName}]"
                        if @probe == "[]" {
                            @albumName = "UMDL"
                        }
                        @cfgAlbum = @albumName
                        @cfgDest = "photos"
                    item "📚 Library only":
                        @cfgAlbum = "Recents"
                        @cfgDest = "photos"
                    item "📁 Files":
                        // Kept exactly as downloaded: nothing is repacked or converted.
                        @cfgDest = "files"
                }
                @settingTouched = "1"
            }

            if @setting == "Conversion" {
                menu "Conversion\n\nSome sites have their best version only in a format Photos cannot play. Converting it can take a while." {
                    item "❓ Ask each time":
                        @cfgConvert = "ask"
                    item "🎞️ Always, for the best quality":
                        @cfgConvert = "yes"
                    item "⚡ Never, take what Photos plays":
                        @cfgConvert = "no"
                }
                @settingTouched = "1"
            }

            if @setting == "Resolution" {
                menu "Highest resolution" {
                    item "Best available":
                        @cfgRes = "best"
                    item "2160p (4K)":
                        @cfgRes = "2160"
                    item "1440p":
                        @cfgRes = "1440"
                    item "1080p":
                        @cfgRes = "1080"
                    item "720p":
                        @cfgRes = "720"
                    item "480p":
                        @cfgRes = "480"
                }
                @settingTouched = "1"
            }

            if @setting == "Frame rate" {
                menu "Highest frame rate" {
                    item "Best available":
                        @cfgFps = "best"
                    item "60 fps":
                        @cfgFps = "60"
                    item "30 fps":
                        @cfgFps = "30"
                }
                @settingTouched = "1"
            }

            if @setting == "Large downloads" {
                const thresholdTyped = prompt("Ask before downloading more than", "Number", "{@cfgThreshold}")
                @thresholdText = "{thresholdTyped}"
                const thresholdMatch = matchText("^[1-9][0-9]?[0-9]?[0-9]?$", @thresholdText)
                @thresholdValid = "{thresholdMatch}"
                @probe = "[{@thresholdValid}]"
                if @probe == "[]" {
                    alert("Enter a whole number from 1 to 9999.", "Not saved")
                } else {
                    @cfgThreshold = @thresholdValid
                    @settingTouched = "1"
                }
            }

            if @setting == "When finished" {
                if @cfgAfter == "photos" {
                    @cfgAfter = "notify"
                } else {
                    @cfgAfter = "photos"
                }
                @settingTouched = "1"
            }

            if @setting == "Reset" {
                menu "Reset\n\nRemove everything also deletes UMDL's files and tools in a-Shell. Photos are kept." {
                    item "🔑 Sign out of all sites":
                        @toolCmd = "logout"
                        @settingsOpen = "0"
                    item "🗑️ Remove everything":
                        @toolCmd = "reset"
                        @settingsOpen = "0"
                    item "Cancel":
                        @probe = "[]"
                }
            }

            if @setting == "Done" {
                @settingsOpen = "0"
            }

            if @settingTouched == "1" {
                @settingsChanged = "1"
                const liveCfg = {"album": "{@cfgAlbum}", "dest": "{@cfgDest}", "convert": "{@cfgConvert}", "threshold": "{@cfgThreshold}", "after": "{@cfgAfter}", "res": "{@cfgRes}", "fps": "{@cfgFps}"}
                const liveCfgText = text("{liveCfg}")
                const liveCfgBlob = base64Encode(liveCfgText, "None")
                rawAction("AsheKube.app.a-Shell.ExecuteCommandIntent", {
                    "command": "dash -c 'mkdir -p $HOME/Documents/UMDL; echo {liveCfgBlob} > $HOME/Documents/UMDL/config.b64'",
                    "openWindow": "close",
                    "keepGoing": true,
                    "ShowWhenRun": false
                })
            }
        }
    }

    // Outside setup, closing Settings ends the run unless Reset asked for the helper.
    if @firstRun == "0" {
        if @toolCmd == "none" {
            if @settingsChanged == "1" {
                showNotification("Settings saved.", "UMDL")
            }
            stop()
        }
    }
}

if @saveCfg == "1" {
    const cfgOut = {"album": "{@cfgAlbum}", "dest": "{@cfgDest}", "convert": "{@cfgConvert}", "threshold": "{@cfgThreshold}", "after": "{@cfgAfter}", "res": "{@cfgRes}", "fps": "{@cfgFps}"}
    const cfgOutText = text("{cfgOut}")
    const cfgOutBlob = base64Encode(cfgOutText, "None")
    rawAction("AsheKube.app.a-Shell.ExecuteCommandIntent", {
        "command": "dash -c 'mkdir -p $HOME/Documents/UMDL; echo {cfgOutBlob} > $HOME/Documents/UMDL/config.b64'",
        "openWindow": "close",
        "keepGoing": true,
        "ShowWhenRun": false
    })
}

/* ------------------------------------------------------------------------
 * 7. Fetch the helper if needed, then hand over to a-Shell
 * ---------------------------------------------------------------------- */

// Signing in is done by the helper, which waits for the sign-in to be stored
// and reports back, so there is no doubt about whether it worked.
@probe = "[{@signInTo}]"
if @probe != "[]" {
    alert("Sign in on the page that opens. UMDL returns here once it is saved.\n\nIf it does not, swipe in from the left edge and check Status.", "Sign in")
    @toolCmd = "signin"
    @link = @signInTo
}

if @toolCmd == "none" {
    if @hasLink == "1" {
        @toolCmd = "run"
    } else {
        if @firstRun == "1" {
            @toolCmd = "setup"
        } else {
            stop()
        }
    }
}

@fetchInApp = "0"
if @needsHelper == "1" {
    // Downloaded without opening a-Shell when possible.
    // "env" is the virtual environment version 1.0 used; it is no longer needed.
    const helperFetch = rawAction("AsheKube.app.a-Shell.ExecuteCommandIntent", {
        "command": "dash -c 'W=\"$HOME/Documents/UMDL\"; mkdir -p $W; rm -rf $W/env $W/umdl.new; curl -fsL --max-time 60 https://raw.githubusercontent.com/TheKfcBandit/UMDL/main/src/umdl.py -o $W/umdl.new && mv -f $W/umdl.new $W/umdl.py && echo {@umdlVersion} > $W/helper.for; if [ -f $W/umdl.py ] && [ -f $W/helper.for ]; then echo \"FOR:$(cat $W/helper.for):END\"; fi; echo DONE'",
        "openWindow": "close",
        "keepGoing": true,
        "ShowWhenRun": false
    })
    @helperState = "{helperFetch}"
    if @helperState !contains "FOR:{@umdlVersion}:END" {
        // The background extension could not fetch it. Download it in the app instead.
        @fetchInApp = "1"
    }
}

const payload = {"v": "{@umdlVersion}", "p": "{@protocol}", "name": "UMDL", "url": "{@link}", "mode": "{@runMode}", "limit": "{@runLimit}", "convert": "{@runConvert}", "force_update": "{@forceUpdate}", "cfg": {"album": "{@cfgAlbum}", "dest": "{@cfgDest}", "convert": "{@cfgConvert}", "threshold": "{@cfgThreshold}", "after": "{@cfgAfter}", "res": "{@cfgRes}", "fps": "{@cfgFps}"}}
const payloadText = text("{payload}")
const payloadBlob = base64Encode(payloadText, "None")
@blob = "{payloadBlob}"

// "Resume last download" replays the interrupted request exactly as it was sent.
if @toolCmd == "resume" {
    @toolCmd = "run"
    @blob = @resumeBlob
}

@appCommand = "cd $HOME/Documents/UMDL\npython umdl.py {@toolCmd} {@blob}\nclear && cd"
if @needsHelper == "1" {
    // First run, or first run after an update: install the download tools before the
    // helper starts. The helper installs anything still missing by itself.
    @appCommand = "cd $HOME/Documents/UMDL\npip install -q --disable-pip-version-check --upgrade yt-dlp gallery-dl\npython umdl.py {@toolCmd} {@blob}\nclear && cd"
}
if @fetchInApp == "1" {
    // If the download fails here too, the shortcut is reopened to report it (section 1).
    @appCommand = "mkdir -p $HOME/Documents/UMDL\ncd $HOME/Documents/UMDL\nrm -rf env umdl.py helper.for\ncurl -fsL --max-time 60 https://raw.githubusercontent.com/TheKfcBandit/UMDL/main/src/umdl.py -o umdl.py\ndash -c 'if [ -s umdl.py ]; then echo {@umdlVersion} > helper.for; else open \"shortcuts://run-shortcut?name=UMDL&input=text&text=UMDL-HELPER-MISSING\"; fi'\npip install -q --disable-pip-version-check --upgrade yt-dlp gallery-dl\npython umdl.py {@toolCmd} {@blob}\nclear && cd"
}

openApp("AsheKube.app.a-Shell")
wait(1)
rawAction("AsheKube.app.a-Shell.ExecuteCommandIntent", {
    "command": "{@appCommand}",
    "openWindow": "open",
    "keepGoing": false,
    "ShowWhenRun": false
})
