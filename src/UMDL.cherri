/*
 * UMDL - Universal Media Downloader
 * One tap from the share sheet: the best available quality, saved straight to Photos.
 *
 * This shortcut is the front end. The download itself is done by src/umdl.py,
 * which runs yt-dlp and gallery-dl inside the free a-Shell app.
 *
 * Build from the repository root:   cherri src/UMDL.cherri
 * Project: https://github.com/TheKfcBandit/UMDL   Licence: MIT
 *
 * Every screen and every path through this file is described in
 * docs/BEHAVIOR.md. Keep the two in step.
 *
 * Two rules this file follows, both learned on a real device:
 *
 *   1. Never test a text for "has any value". Shortcuts treats an empty text
 *      as a value. Emptiness is tested by wrapping the text in brackets and
 *      comparing with "[]".
 *   2. Cherri functions are not used. They re-run the shortcut and read its
 *      input, which is the same channel the helper's callback uses.
 */

#define name UMDL
#define color blue
#define glyph downloadArrow
#define inputs url, text
#define from sharesheet

#include 'actions/crypto'
#include 'actions/text'
#include 'actions/web'
#include 'actions/photos'
#include 'actions/device'
#include 'actions/sharing'

// Keep in step with version.json. The protocol number only changes when the
// payload or callback format does.
@umdlVersion = "1.1.0"
@protocol = "2"

@shared = "{ShortcutInput}"
@link = ""
@hasLink = "0"
@runMode = "auto"
@runLimit = ""
@forceUpdate = ""
@toolCmd = "none"
@signInTo = ""
@saveManifest = ""
@pendingManifest = ""
@resumeBlob = ""
@choice = ""
@firstRun = "0"
@probe = ""

@cfgAlbum = "UMDL"
@cfgThreshold = "10"
@cfgConvert = "1"
@cfgAfter = "notify"
@haveCfg = "0"
@needsHelper = "0"
@saveCfg = "0"
@askAlbum = "0"
@askConvert = "0"
@settingsChanged = "0"

@failedCount = ""
@jobTitle = ""
@updateVersion = ""
@updateLink = ""

/* ------------------------------------------------------------------------
 * 1. What started this run: a callback from the helper, or something shared
 * ---------------------------------------------------------------------- */

// Sent by the in-app helper download (section 8) when it fails.
if @shared == "UMDL-HELPER-MISSING" {
    alert("UMDL could not download its helper script.\n\nCheck the internet connection, then run UMDL again.", "Setup incomplete")
    stop()
}

if @shared beginsWith "UMDLCB:" {
    const cbBlob = replaceText("UMDLCB:", "", @shared)
    const cbData = base64Decode(cbBlob)
    @cbJSON = "{cbData}"
    // A callback that cannot be read is ignored: the run continues as if nothing was shared.
    if @cbJSON contains "\"t\":" {
        const cb = getDictionary(@cbJSON)
        @cbType = "{cb['t']}"

        // Every callback carries the settings back, so no second trip to a-Shell.
        const cbCfgRaw = getValue(cb, "cfg")
        const cbCfg = getDictionary(cbCfgRaw)
        @probe = "[{cbCfg['album']}]"
        if @probe != "[]" {
            @cfgAlbum = "{cbCfg['album']}"
            @cfgThreshold = "{cbCfg['threshold']}"
            @cfgConvert = "{cbCfg['convert']}"
            @cfgAfter = "{cbCfg['after']}"
            @haveCfg = "1"
        }

        if @cbType == "done" {
            @saveManifest = "{cb['m']}"
            @failedCount = "{cb['nf']}"
            @jobTitle = "{cb['title']}"
            @updateVersion = "{cb['upv']}"
            @updateLink = "{cb['upurl']}"
        }

        if @cbType == "confirm" {
            @link = "{cb['url']}"
            @confirmLimit = "{cb['thr']}"
            @confirmPrompt = "This link contains more than {@confirmLimit} items."
            @probe = "[{cb['n']}]"
            if @probe != "[]" {
                @confirmPrompt = "This link contains {cb['n']} items."
            }
            @probe = "[{cb['title']}]"
            if @probe != "[]" {
                @confirmPrompt = "{cb['title']}\n\n{@confirmPrompt}"
            }
            menu "{@confirmPrompt}" {
                item "⬇️ Download all":
                    @runMode = "all"
                item "⬇️ Download the first {@confirmLimit}":
                    @runMode = "limit"
                    @runLimit = @confirmLimit
                item "⬇️ Download the first item only":
                    @runMode = "first"
                item "Cancel":
                    stop()
            }
        }

        if @cbType == "error" {
            @errKind = "{cb['kind']}"
            @errText = "{cb['msg']}"
            @errLink = "{cb['url']}"
            if @errKind == "install" {
                alert("The download tools could not be installed.\n\n{@errText}\n\nCheck the internet connection, then run UMDL again.", "Setup incomplete")
                stop()
            }
            if @errKind == "outdated" {
                menu "This copy of UMDL is out of date and cannot continue.\n\n{@errText}" {
                    item "⬇️ Get the latest version":
                        openURL("https://github.com/TheKfcBandit/UMDL/releases/latest")
                        stop()
                    item "Cancel":
                        stop()
                }
            }
            if @errKind == "nolink" {
                alert("UMDL needs a web link. Share a post or video to UMDL, or copy its link first.", "No link found")
                stop()
            }
            @errHint = "Updating the download tools resolves most failures."
            if @errKind == "auth" {
                @errHint = "This post appears to require an account. Sign in to the site, then try again."
            }
            if @errKind == "network" {
                @errHint = "Check the internet connection, then try again."
            }
            if @errKind == "gone" {
                @errHint = "The post may be private, removed, or unavailable in your region."
            }
            if @errKind == "drm" {
                @errHint = "This media is copy-protected and cannot be downloaded."
            }
            if @errKind == "unsupported" {
                @errHint = "This site may not be supported."
            }
            menu "Download failed\n\n{@errText}\n\n{@errHint}" {
                item "🔄 Try again":
                    @link = @errLink
                item "🛠️ Update tools and try again":
                    @link = @errLink
                    @forceUpdate = "1"
                item "🔑 Sign in to this site":
                    const errHost = getURLDetail(@errLink, "Host")
                    @signInTo = "https://{errHost}"
                item "📋 Copy error details":
                    @errReport = "UMDL {@umdlVersion}\n{@errLink}\n{@errKind}: {@errText}"
                    setClipboard(@errReport)
                    stop()
                item "Cancel":
                    stop()
            }
        }

        if @cbType == "info" {
            alert("{cb['msg']}", "{cb['title']}")
            stop()
        }

        if @cbType == "setup" {
            alert("Setup is complete.\n\nTo download, share a post or video to UMDL from any app.\n\nTo change settings, open UMDL from the Shortcuts app.", "UMDL is ready")
            stop()
        }
    }
} else {
    const sharedLinks = getURLs(@shared)
    const sharedFirst = getFirstItem(sharedLinks)
    @link = "{sharedFirst}"
}

@probe = "[{@link}]"
if @probe != "[]" {
    @hasLink = "1"
}

/* ------------------------------------------------------------------------
 * 2. Settings and state, read from a-Shell without opening it
 * ---------------------------------------------------------------------- */

if @haveCfg == "0" {
    const preflight = rawAction("AsheKube.app.a-Shell.ExecuteCommandIntent", {
        "command": "dash -c 'W=\"$HOME/Documents/UMDL\"; if [ -f $W/config.b64 ]; then echo \"CFG:$(cat $W/config.b64)\"; fi; if [ -f $W/umdl.py ] && [ -f $W/helper.for ]; then echo \"FOR:$(cat $W/helper.for):END\"; fi; if [ -f $W/pending ]; then echo \"PENDING:$(cat $W/pending)\"; fi; if [ -f $W/last.b64 ]; then echo \"LAST:$(cat $W/last.b64)\"; fi; echo DONE'",
        "openWindow": "close",
        "keepGoing": false,
        "ShowWhenRun": false
    })
    @state = "{preflight}"

    // The helper is fetched again whenever the shortcut's version changes.
    @needsHelper = "1"
    if @state contains "FOR:{@umdlVersion}:END" {
        @needsHelper = "0"
    }

    const cfgMatch = matchText("CFG:(\\S+)", @state)
    const cfgGroup = getMatchGroup(cfgMatch, 1)
    @cfgBlob = "{cfgGroup}"
    @probe = "[{@cfgBlob}]"
    if @probe != "[]" {
        const cfgData = base64Decode(@cfgBlob)
        @cfgJSON = "{cfgData}"
        // A damaged settings file is treated as no settings, not as an error.
        if @cfgJSON contains "\"album\"" {
            const cfg = getDictionary(@cfgJSON)
            @cfgAlbum = "{cfg['album']}"
            @cfgThreshold = "{cfg['threshold']}"
            @cfgConvert = "{cfg['convert']}"
            @cfgAfter = "{cfg['after']}"
            @haveCfg = "1"
        }
    }

    const pendingMatch = matchText("PENDING:(\\S+)", @state)
    const pendingGroup = getMatchGroup(pendingMatch, 1)
    @pendingManifest = "{pendingGroup}"

    const lastMatch = matchText("LAST:(\\S+)", @state)
    const lastGroup = getMatchGroup(lastMatch, 1)
    @resumeBlob = "{lastGroup}"
}

// A setting that is missing falls back to its default.
@probe = "[{@cfgAlbum}]"
if @probe == "[]" {
    @cfgAlbum = "Recents"
}
@probe = "[{@cfgThreshold}]"
if @probe == "[]" {
    @cfgThreshold = "10"
}
@probe = "[{@cfgConvert}]"
if @probe == "[]" {
    @cfgConvert = "1"
}
@probe = "[{@cfgAfter}]"
if @probe == "[]" {
    @cfgAfter = "notify"
}

/* ------------------------------------------------------------------------
 * 3. First run: the setup wizard
 * ---------------------------------------------------------------------- */

if @haveCfg == "0" {
    menu "Welcome to UMDL\n\nUMDL saves shared posts and videos to Photos at the best quality your library can play. Downloads run on this device, in the a-Shell app.\n\nQuick setup saves to a new album named UMDL and installs the download tools. It takes about two minutes and needs an internet connection." {
        item "✅ Quick setup (recommended)":
            createAlbum("UMDL")
            @cfgAlbum = "UMDL"
            @saveCfg = "1"
            @firstRun = "1"
        item "⚙️ Custom setup":
            @askAlbum = "1"
            @askConvert = "1"
            @firstRun = "1"
        item "Not now":
            stop()
    }
}

/* ------------------------------------------------------------------------
 * 4. A finished download that never reached Photos
 * ---------------------------------------------------------------------- */

// Not asked during setup, nor when this run is already delivering a download.
@probe = "[{@pendingManifest}]"
if @firstRun == "1" {
    @probe = "[]"
}
@saveProbe = "[{@saveManifest}]"
if @saveProbe != "[]" {
    @probe = "[]"
}
if @probe != "[]" {
    menu "A download from an earlier run has not been saved to Photos." {
        item "💾 Save it now":
            @saveManifest = @pendingManifest
        item "🗑️ Discard it":
            const discardDir = replaceText("/manifest.json", "", @pendingManifest)
            @discardPath = "{discardDir}"
            if @discardPath contains "/Documents/UMDL/jobs/" {
                rawAction("AsheKube.app.a-Shell.ExecuteCommandIntent", {
                    "command": "rm -rf {@discardPath} $HOME/Documents/UMDL/pending",
                    "openWindow": "close",
                    "keepGoing": false,
                    "ShowWhenRun": false
                })
            }
    }
}

/* ------------------------------------------------------------------------
 * 5. Save to Photos
 * ---------------------------------------------------------------------- */

@probe = "[{@saveManifest}]"
if @probe != "[]" {
    const manifestFile = rawAction("AsheKube.app.a-Shell.GetFileIntent", {
        "fileName": "{@saveManifest}",
        "errorIfNotFound": true,
        "ShowWhenRun": false
    })
    const manifest = getDictionary(manifestFile)
    const photoPaths = getValue(manifest, "photos")
    const keptNames = getValue(manifest, "kept")
    const keptTotal = count(keptNames)
    @keptCount = "{keptTotal}"

    @savedCount = 0
    for photoPath in photoPaths {
        const mediaFile = rawAction("AsheKube.app.a-Shell.GetFileIntent", {
            "fileName": "{photoPath}",
            "errorIfNotFound": true,
            "ShowWhenRun": false
        })
        if @cfgAlbum == "Recents" {
            savePhoto(mediaFile)
        } else {
            savePhoto(mediaFile, @cfgAlbum)
        }
        @savedCount += 1
    }

    // Everything is in Photos now, so the working copies can go.
    const jobDir = replaceText("/manifest.json", "", @saveManifest)
    @jobPath = "{jobDir}"
    if @jobPath contains "/Documents/UMDL/jobs/" {
        rawAction("AsheKube.app.a-Shell.ExecuteCommandIntent", {
            "command": "rm -rf {@jobPath} $HOME/Documents/UMDL/pending",
            "openWindow": "close",
            "keepGoing": false,
            "ShowWhenRun": false
        })
    }

    @albumLabel = "the {@cfgAlbum} album"
    if @cfgAlbum == "Recents" {
        @albumLabel = "Photos"
    }
    @summary = "Saved {@savedCount} items to {@albumLabel}."
    if @savedCount == 1 {
        @summary = "Saved to {@albumLabel}."
    }
    if @savedCount == 0 {
        @summary = "No items could be added to Photos."
    }
    if @keptCount != "0" {
        @summary = "{@summary}\n{@keptCount} kept in Files, under a-Shell, UMDL, Saved."
    }
    @probe = "[{@failedCount}]"
    if @probe != "[]" {
        @summary = "{@summary}\n{@failedCount} could not be downloaded."
    }
    @summaryTitle = "UMDL"
    @probe = "[{@jobTitle}]"
    if @probe != "[]" {
        @summaryTitle = @jobTitle
    }
    showNotification("{@summary}", "{@summaryTitle}")

    @probe = "[{@updateVersion}]"
    if @probe != "[]" {
        menu "UMDL {@updateVersion} is available. The installed version is {@umdlVersion}." {
            item "⬇️ Get the update":
                openURL("{@updateLink}")
                stop()
            item "Later":
                @probe = "[]"
        }
    }
    if @hasLink == "0" {
        if @cfgAfter == "photos" {
            openURL("photos-redirect://")
        }
        stop()
    }
}

/* ------------------------------------------------------------------------
 * 6. Opened without a link: the main menu
 * ---------------------------------------------------------------------- */

@needsMenu = "1"
if @hasLink == "1" {
    @needsMenu = "0"
}
if @firstRun == "1" {
    @needsMenu = "0"
}
@probe = "[{@signInTo}]"
if @probe != "[]" {
    @needsMenu = "0"
}

if @needsMenu == "1" {
    const iconDownload = embedFile("assets/icons/download.png")
    const iconPencil = embedFile("assets/icons/pencil.png")
    const iconResume = embedFile("assets/icons/resume.png")
    const iconSettings = embedFile("assets/icons/settings.png")
    const iconKey = embedFile("assets/icons/key.png")
    const iconUpdate = embedFile("assets/icons/update.png")
    const iconInfo = embedFile("assets/icons/info.png")

    @cards = "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Download from clipboard;;;;\nORG;CHARSET=utf-8:Uses the most recently copied link;\nPHOTO;ENCODING=b:{iconDownload}\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Enter a link;;;;\nORG;CHARSET=utf-8:Type or paste a link to a post or video;\nPHOTO;ENCODING=b:{iconPencil}\nEND:VCARD\n"
    @probe = "[{@resumeBlob}]"
    if @probe != "[]" {
        @cards = "{@cards}BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Resume last download;;;;\nORG;CHARSET=utf-8:Continues the download that was interrupted;\nPHOTO;ENCODING=b:{iconResume}\nEND:VCARD\n"
    }
    @cards = "{@cards}BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Settings;;;;\nORG;CHARSET=utf-8:Album and download options;\nPHOTO;ENCODING=b:{iconSettings}\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Sign in to a site;;;;\nORG;CHARSET=utf-8:Required for private or age-restricted posts;\nPHOTO;ENCODING=b:{iconKey}\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Update tools;;;;\nORG;CHARSET=utf-8:Installs the latest yt-dlp and gallery-dl;\nPHOTO;ENCODING=b:{iconUpdate}\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:About UMDL;;;;\nORG;CHARSET=utf-8:Version {@umdlVersion}. Updates and diagnostics;\nPHOTO;ENCODING=b:{iconInfo}\nEND:VCARD\n"

    // The third argument keeps the name exactly as written, so the text becomes a .vcf file.
    const cardsFile = setName(@cards, "umdl-menu.vcf", true)
    @cardsContacts = cardsFile.contact
    const cardsPick = chooseFromList(@cardsContacts, "UMDL")
    @choice = "{cardsPick}"

    if @choice == "Download from clipboard" {
        @clipText = "{Clipboard}"
        const clipLinks = getURLs(@clipText)
        const clipFirst = getFirstItem(clipLinks)
        @link = "{clipFirst}"
        @probe = "[{@link}]"
        if @probe == "[]" {
            alert("The clipboard does not contain a link. Copy the link to a post or video, then try again.", "No link found")
            stop()
        }
        @hasLink = "1"
    }

    if @choice == "Enter a link" {
        const typed = prompt("Link to download", "URL")
        @typedText = "{typed}"
        const typedLinks = getURLs(@typedText)
        const typedFirst = getFirstItem(typedLinks)
        @link = "{typedFirst}"
        @probe = "[{@link}]"
        if @probe == "[]" {
            alert("The text entered is not a web link.", "No link found")
            stop()
        }
        @hasLink = "1"
    }

    if @choice == "Resume last download" {
        @toolCmd = "resume"
    }

    if @choice == "Update tools" {
        @toolCmd = "update"
    }

    if @choice == "Sign in to a site" {
        menu "Choose a site to sign in to.\n\nThe sign-in is stored on this device, inside a-Shell." {
            item "Instagram":
                @signInTo = "https://www.instagram.com/accounts/login/"
            item "X (Twitter)":
                @signInTo = "https://x.com/login"
            item "Reddit":
                @signInTo = "https://www.reddit.com/login/"
            item "TikTok":
                @signInTo = "https://www.tiktok.com/login"
            item "Facebook":
                @signInTo = "https://m.facebook.com/login/"
            item "Another site":
                const siteTyped = prompt("Address of the site's sign-in page", "URL", "https://")
                @siteText = "{siteTyped}"
                const siteLinks = getURLs(@siteText)
                const siteFirst = getFirstItem(siteLinks)
                @siteLink = "{siteFirst}"
                @probe = "[{@siteLink}]"
                if @probe == "[]" {
                    alert("The text entered is not a web address.", "Sign in")
                    stop()
                }
                // Host only: a query string would not survive a-Shell's command line.
                const siteHost = getURLDetail(@siteLink, "Host")
                @signInTo = "https://{siteHost}"
        }
    }

    if @choice == "About UMDL" {
        menu "UMDL {@umdlVersion}\n\nA free, open-source media downloader.\nPowered by yt-dlp, gallery-dl and a-Shell." {
            item "🔄 Check for a new version":
                const latestRaw = rawAction("AsheKube.app.a-Shell.ExecuteCommandIntent", {
                    "command": "curl -fsL --max-time 10 https://raw.githubusercontent.com/TheKfcBandit/UMDL/main/version.json",
                    "openWindow": "close",
                    "keepGoing": false,
                    "ShowWhenRun": false
                })
                @latestText = "{latestRaw}"
                if @latestText !contains "\"shortcut\"" {
                    alert("GitHub could not be reached. Check the internet connection, then try again.", "Update check")
                    stop()
                }
                const latest = getDictionary(@latestText)
                @latestVersion = "{latest['shortcut']}"
                if @latestVersion == @umdlVersion {
                    alert("Version {@umdlVersion} is the latest version.", "UMDL is up to date")
                    stop()
                }
                menu "UMDL {@latestVersion} is available. The installed version is {@umdlVersion}.\n\n{latest['notes']}" {
                    item "⬇️ Get the update":
                        openURL("{latest['url']}")
                    item "Later":
                        @latestVersion = ""
                }
                stop()
            item "🩺 Run diagnostics":
                @toolCmd = "doctor"
            item "🌐 Open the project page":
                openURL("https://github.com/TheKfcBandit/UMDL")
                stop()
            item "Done":
                stop()
        }
    }

    if @choice == "Settings" {
        const iconAlbum = embedFile("assets/icons/album.png")
        const iconStack = embedFile("assets/icons/stack.png")
        const iconConvert = embedFile("assets/icons/convert.png")
        const iconFinish = embedFile("assets/icons/finish.png")
        const iconForget = embedFile("assets/icons/forget.png")
        const iconReset = embedFile("assets/icons/reset.png")

        // Commas, semicolons and backslashes are separators inside a vCard.
        const albumShown = replaceText("[\\\\;,]", " ", @cfgAlbum, true, true)
        @albumDetail = "{albumShown}"
        if @cfgAlbum == "Recents" {
            @albumDetail = "Photo library. No album"
        }
        @convertShown = "Convert for Photos"
        if @cfgConvert == "0" {
            @convertShown = "Keep the original in Files"
        }
        @afterShown = "Show a notification"
        if @cfgAfter == "photos" {
            @afterShown = "Open Photos"
        }

        @settingCards = "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Save to;;;;\nORG;CHARSET=utf-8:{@albumDetail};\nPHOTO;ENCODING=b:{iconAlbum}\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Ask before large downloads;;;;\nORG;CHARSET=utf-8:When a link contains more than {@cfgThreshold} items;\nPHOTO;ENCODING=b:{iconStack}\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Unsupported video formats;;;;\nORG;CHARSET=utf-8:{@convertShown};\nPHOTO;ENCODING=b:{iconConvert}\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:When a download finishes;;;;\nORG;CHARSET=utf-8:{@afterShown};\nPHOTO;ENCODING=b:{iconFinish}\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Forget saved sign-ins;;;;\nORG;CHARSET=utf-8:Signs out of every site;\nPHOTO;ENCODING=b:{iconForget}\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Reset UMDL;;;;\nORG;CHARSET=utf-8:Removes the helper and all settings;\nPHOTO;ENCODING=b:{iconReset}\nEND:VCARD\n"

        const settingsFile = setName(@settingCards, "umdl-settings.vcf", true)
        @settingsContacts = settingsFile.contact
        const settingsPick = chooseFromList(@settingsContacts, "Settings")
        @setting = "{settingsPick}"

        if @setting == "Save to" {
            @askAlbum = "1"
            @settingsChanged = "1"
        }

        if @setting == "Ask before large downloads" {
            const thresholdTyped = prompt("Ask first when a link contains more than this many items", "Number", "{@cfgThreshold}")
            @thresholdText = "{thresholdTyped}"
            const thresholdMatch = matchText("^[1-9][0-9]?[0-9]?[0-9]?$", @thresholdText)
            @thresholdValid = "{thresholdMatch}"
            @probe = "[{@thresholdValid}]"
            if @probe == "[]" {
                alert("Enter a whole number from 1 to 9999.", "Not saved")
                stop()
            }
            @cfgThreshold = @thresholdValid
            @saveCfg = "1"
            @settingsChanged = "1"
        }

        if @setting == "Unsupported video formats" {
            @askConvert = "1"
            @settingsChanged = "1"
        }

        if @setting == "When a download finishes" {
            menu "When a download finishes" {
                item "🔔 Show a notification":
                    @cfgAfter = "notify"
                item "🖼️ Open Photos":
                    @cfgAfter = "photos"
            }
            @saveCfg = "1"
            @settingsChanged = "1"
        }

        if @setting == "Forget saved sign-ins" {
            @toolCmd = "logout"
        }

        if @setting == "Reset UMDL" {
            menu "Remove UMDL's helper, settings and working files from a-Shell?\n\nPhotos and the shortcut itself are not affected. Files kept under a-Shell, UMDL, Saved are deleted." {
                item "🗑️ Reset UMDL":
                    rawAction("AsheKube.app.a-Shell.ExecuteCommandIntent", {
                        "command": "rm -rf $HOME/Documents/UMDL",
                        "openWindow": "close",
                        "keepGoing": false,
                        "ShowWhenRun": false
                    })
                    alert("UMDL's files have been removed. Run UMDL again to set it up, or delete the shortcut.", "UMDL was reset")
                    stop()
                item "Cancel":
                    stop()
            }
        }
    }
}

/* ------------------------------------------------------------------------
 * 7. Questions shared by custom setup and Settings
 * ---------------------------------------------------------------------- */

if @askAlbum == "1" {
    menu "Where should downloads be saved?" {
        item "🆕 A new album":
            const newAlbum = prompt("Name for the new album", nil, "UMDL")
            @newAlbumName = "{newAlbum}"
            @probe = "[{@newAlbumName}]"
            if @probe == "[]" {
                @newAlbumName = "UMDL"
            }
            createAlbum("{@newAlbumName}")
            @cfgAlbum = @newAlbumName
        item "🖼️ An existing album":
            const oldAlbum = prompt("Enter the album name exactly as Photos shows it", nil, "{@cfgAlbum}")
            @oldAlbumName = "{oldAlbum}"
            @probe = "[{@oldAlbumName}]"
            if @probe == "[]" {
                @oldAlbumName = "Recents"
            }
            @cfgAlbum = @oldAlbumName
        item "📚 The photo library, without an album":
            @cfgAlbum = "Recents"
    }
    @saveCfg = "1"
}

if @askConvert == "1" {
    menu "UMDL downloads the best quality that Photos can play. When a site only offers a format Photos cannot play, what should happen?" {
        item "🎞️ Convert it for Photos (slower)":
            @cfgConvert = "1"
        item "📁 Keep the original in Files":
            @cfgConvert = "0"
    }
    @saveCfg = "1"
}

if @saveCfg == "1" {
    const cfgOut = {"album": "{@cfgAlbum}", "threshold": "{@cfgThreshold}", "convert": "{@cfgConvert}", "after": "{@cfgAfter}"}
    const cfgOutText = text("{cfgOut}")
    const cfgOutBlob = base64Encode(cfgOutText, "None")
    rawAction("AsheKube.app.a-Shell.ExecuteCommandIntent", {
        "command": "dash -c 'mkdir -p $HOME/Documents/UMDL; echo {cfgOutBlob} > $HOME/Documents/UMDL/config.b64'",
        "openWindow": "close",
        "keepGoing": false,
        "ShowWhenRun": false
    })
}

if @settingsChanged == "1" {
    showNotification("Settings saved.", "UMDL")
    stop()
}

/* ------------------------------------------------------------------------
 * 8. Fetch the helper if needed, then hand over to a-Shell
 * ---------------------------------------------------------------------- */

@probe = "[{@signInTo}]"
if @probe != "[]" {
    alert("a-Shell will open the site's sign-in page. Sign in, then return to the previous app.\n\nTo close the page, swipe right from the left edge of the screen.", "Sign in")
    openApp("AsheKube.app.a-Shell")
    wait(1)
    rawAction("AsheKube.app.a-Shell.ExecuteCommandIntent", {
        "command": "internalbrowser {@signInTo}",
        "openWindow": "open",
        "keepGoing": false,
        "ShowWhenRun": false
    })
    stop()
}

if @toolCmd == "none" {
    if @hasLink == "1" {
        @toolCmd = "run"
    } else {
        if @firstRun == "1" {
            @toolCmd = "setup"
        } else {
            stop()
        }
    }
}

@fetchInApp = "0"
if @needsHelper == "1" {
    // Downloaded without opening a-Shell when possible.
    // "env" is the virtual environment version 1.0 used; it is no longer needed.
    const helperFetch = rawAction("AsheKube.app.a-Shell.ExecuteCommandIntent", {
        "command": "dash -c 'W=\"$HOME/Documents/UMDL\"; mkdir -p $W; rm -rf $W/env $W/umdl.new; curl -fsL --max-time 60 https://raw.githubusercontent.com/TheKfcBandit/UMDL/main/src/umdl.py -o $W/umdl.new && mv -f $W/umdl.new $W/umdl.py && echo {@umdlVersion} > $W/helper.for; if [ -f $W/umdl.py ] && [ -f $W/helper.for ]; then echo \"FOR:$(cat $W/helper.for):END\"; fi; echo DONE'",
        "openWindow": "close",
        "keepGoing": false,
        "ShowWhenRun": false
    })
    @helperState = "{helperFetch}"
    if @helperState !contains "FOR:{@umdlVersion}:END" {
        // The background extension could not fetch it. Download it in the app instead.
        @fetchInApp = "1"
    }
}

const payload = {"v": "{@umdlVersion}", "p": "{@protocol}", "name": "UMDL", "url": "{@link}", "mode": "{@runMode}", "limit": "{@runLimit}", "force_update": "{@forceUpdate}", "cfg": {"album": "{@cfgAlbum}", "threshold": "{@cfgThreshold}", "convert": "{@cfgConvert}", "after": "{@cfgAfter}"}}
const payloadText = text("{payload}")
const payloadBlob = base64Encode(payloadText, "None")
@blob = "{payloadBlob}"

// "Resume last download" replays the interrupted request exactly as it was sent.
if @toolCmd == "resume" {
    @toolCmd = "run"
    @blob = @resumeBlob
}

@appCommand = "cd $HOME/Documents/UMDL\npython umdl.py {@toolCmd} {@blob}\nclear && cd"
if @needsHelper == "1" {
    // First run, or first run after an update: install the download tools before the
    // helper starts. The helper installs anything still missing by itself.
    @appCommand = "cd $HOME/Documents/UMDL\npip install -q --disable-pip-version-check --upgrade yt-dlp gallery-dl\npython umdl.py {@toolCmd} {@blob}\nclear && cd"
}
if @fetchInApp == "1" {
    // If the download fails here too, the shortcut is reopened to report it (section 1).
    @appCommand = "mkdir -p $HOME/Documents/UMDL\ncd $HOME/Documents/UMDL\nrm -rf env umdl.py helper.for\ncurl -fsL --max-time 60 https://raw.githubusercontent.com/TheKfcBandit/UMDL/main/src/umdl.py -o umdl.py\ndash -c 'if [ -s umdl.py ]; then echo {@umdlVersion} > helper.for; else open \"shortcuts://run-shortcut?name=UMDL&input=text&text=UMDL-HELPER-MISSING\"; fi'\npip install -q --disable-pip-version-check --upgrade yt-dlp gallery-dl\npython umdl.py {@toolCmd} {@blob}\nclear && cd"
}

openApp("AsheKube.app.a-Shell")
wait(1)
rawAction("AsheKube.app.a-Shell.ExecuteCommandIntent", {
    "command": "{@appCommand}",
    "openWindow": "open",
    "keepGoing": false,
    "ShowWhenRun": false
})
